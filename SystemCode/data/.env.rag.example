# Example only: this file is not auto-loaded. Export these variables in your shell.
OPENAI_API_KEY=replace_locally
FLEETCARE_LLM_MODEL=gpt-5.6
FLEETCARE_DB_HOST=127.0.0.1
FLEETCARE_DB_PORT=3306
FLEETCARE_DB_USER=root
FLEETCARE_DB_PASSWORD=
FLEETCARE_DB_NAME=fleetcareai
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_MIN_SIMILARITY=0.32

# Optional absolute path; default is knowledge_index/fleetcare_knowledge.sqlite3
# FLEETCARE_KNOWLEDGE_DB=/absolute/path/fleetcare_knowledge.sqlite3
# Retrieval loads cached embedding weights only, never downloads a model.

# HTTP adapter: comma-separated exact browser origins (server-side setting)
FLEETCARE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
