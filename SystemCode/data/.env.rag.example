# Export on the server; .env is not auto-loaded.
OPENAI_API_KEY=replace_locally
FLEETCARE_LLM_MODEL=replace_with_available_responses_model
FLEETCARE_DB_HOST=127.0.0.1
FLEETCARE_DB_PORT=5432
FLEETCARE_DB_USER=postgres
FLEETCARE_DB_PASSWORD=
FLEETCARE_DB_NAME=fleetcareai
# Optional PostgreSQL URL overrides the individual database variables.
# FLEETCARE_DATABASE_URL=postgresql+psycopg://user:password@host:5432/fleetcareai
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_MIN_SIMILARITY=0.32
FLEETCARE_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
